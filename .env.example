# SiliconFlow API key — copy this file to .env and fill in locally.
# Never commit a real key.

# Java backend (application.yml reads SILICONFLOW_API_KEY)
SILICONFLOW_API_KEY=

# Frontend browser demo only (Vite inlines VITE_* into the client bundle).
# Prefer the Java backend in production so the key stays on the server.
VITE_SILICONFLOW_API_KEY=
